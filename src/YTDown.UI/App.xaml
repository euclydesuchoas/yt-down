<Application x:Class="YTDown.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:YTDown.UI.Converters">
    <Application.Resources>
        <converters:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBoolean" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Application.Resources>
</Application>
