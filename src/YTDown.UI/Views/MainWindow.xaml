<Window x:Class="YTDown.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTDown — Baixe vídeos do YouTube"
        Width="780" Height="620"
        MinWidth="660" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F8FA"
        FontFamily="Segoe UI">

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="YTDown" Style="{StaticResource HeadingText}" />
                <TextBlock Style="{StaticResource SubtleText}"
                           Margin="0,4,0,0"
                           Text="Cole o endereço do vídeo do YouTube. O arquivo é salvo na sua pasta Downloads." />

                <TextBlock Style="{StaticResource SubtleText}"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="#FF98A0AF"
                           Text="{Binding MaintenanceMessage}"
                           Visibility="{Binding MaintenanceMessage, Converter={StaticResource NotEmptyToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="16,0,0,0"
                        VerticalAlignment="Top">
                <Button Height="34"
                        Padding="16,0"
                        Content="Histórico"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnHistoryRequested" />

                <Button Margin="8,0,0,0"
                        Height="34"
                        Padding="16,0"
                        Content="Configurações"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnSettingsRequested" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,24,0,0"
              IsEnabled="{Binding DownloadCommand.IsRunning, Converter={StaticResource InverseBoolean}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#FFD5DBE5"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         Height="42"
                         Padding="12,0"
                         VerticalContentAlignment="Center" />
            </Border>

            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    Height="42"
                    Content="Buscar"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding SearchCommand}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Height="42"
                    Content="Baixar"
                    Style="{StaticResource FlatButton}"
                    Command="{Binding DownloadCommand}" />
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,14,0,0"
              IsEnabled="{Binding DownloadCommand.IsRunning, Converter={StaticResource InverseBoolean}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Qualidade"
                       Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center"
                       Visibility="{Binding AvailableQualities, Converter={StaticResource NotEmptyToVisibility}}" />

            <ComboBox Grid.Column="1"
                      Margin="10,0,0,0"
                      Width="120"
                      Height="30"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding AvailableQualities}"
                      SelectedItem="{Binding SelectedQuality}"
                      DisplayMemberPath="Label"
                      IsEnabled="{Binding AudioOnly, Converter={StaticResource InverseBoolean}}"
                      Visibility="{Binding AvailableQualities, Converter={StaticResource NotEmptyToVisibility}}" />

            <CheckBox Grid.Column="2"
                      Margin="18,0,0,0"
                      VerticalAlignment="Center"
                      Content="Baixar somente o áudio (MP3)"
                      FontSize="13"
                      Foreground="#FF3B4252"
                      IsChecked="{Binding AudioOnly}" />
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="0,18,0,0"
                    Visibility="{Binding SearchCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource SubtleText}" Text="Buscando informações do vídeo..." />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" BorderThickness="0" />
        </StackPanel>

        <Border Grid.Row="4"
                Margin="0,18,0,0"
                Style="{StaticResource Card}"
                Padding="16,14"
                Visibility="{Binding DownloadCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="13"
                               Foreground="#FF1B1F26" />
                    <ProgressBar Value="{Binding Progress.Percentage, Mode=OneWay}"
                                 Maximum="100"
                                 Height="6"
                                 Margin="0,10,0,0"
                                 BorderThickness="0"
                                 Foreground="#FF2C6BED" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="16,0,0,0"
                        Height="34"
                        Padding="16,0"
                        Content="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DownloadCancelCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Margin="0,18,0,0"
                Padding="14,12"
                Background="#FFFDECEC"
                BorderBrush="#FFF3B9B9"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#FF8C2020" />
        </Border>

        <Border Grid.Row="6"
                Margin="0,18,0,0"
                Padding="16,14"
                Background="#FFEDF9F0"
                BorderBrush="#FFB6E3C4"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding DownloadedFile, Converter={StaticResource NotEmptyToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Download concluído"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FF176034" />
                    <TextBlock Text="{Binding DownloadedFile.FileName}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="#FF3C6B4E"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="16,0,0,0"
                        Height="34"
                        Padding="16,0"
                        Content="Abrir pasta"
                        Style="{StaticResource FlatButton}"
                        Command="{Binding OpenContainingFolderCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="7"
                Margin="0,20,0,0"
                VerticalAlignment="Top"
                Style="{StaticResource Card}"
                Visibility="{Binding Video, Converter={StaticResource NotEmptyToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="200" Height="112"
                        CornerRadius="6"
                        Background="#FFEDF0F5"
                        VerticalAlignment="Top">
                    <Image Source="{Binding Video.ThumbnailUrl}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Video.Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FF1B1F26"
                               TextWrapping="Wrap"
                               MaxHeight="52"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="{Binding Video.ChannelName}"
                               Style="{StaticResource SubtleText}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="{Binding DurationText}"
                               Style="{StaticResource SubtleText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Discreto, mas legivel: o mesmo cinza dos textos de apoio da tela. -->
        <TextBlock Grid.Row="8"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   FontSize="12"
                   Foreground="#FF6A7180"
                   Text="{Binding Credit}" />
    </Grid>
</Window>
