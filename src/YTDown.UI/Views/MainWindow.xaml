<Window x:Class="YTDown.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTDown — Baixe vídeos do YouTube"
        Width="780" Height="645"
        MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F8FA"
        FontFamily="Segoe UI">

    <!--
        IsSharedSizeScope alinha os campos das linhas de escolha: os rotulos tem
        larguras diferentes, e sem isso cada campo comecaria em um ponto,
        formando um ziguezague. A coluna se ajusta sozinha ao rotulo mais largo.
    -->
    <Grid Margin="32,28" Grid.IsSharedSizeScope="True">
        <!--
            A ordem das linhas conta a historia da tela: endereco, o video que
            foi encontrado, as escolhas sobre ele e o resultado. Escolher antes
            de ver o video seria decidir sobre algo que ainda nao apareceu.
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 1  endereco e Buscar -->
            <RowDefinition Height="Auto" />
            <!-- 2  buscando... -->
            <RowDefinition Height="Auto" />
            <!-- 3  erro -->
            <RowDefinition Height="Auto" />
            <!-- 4  o video encontrado -->
            <RowDefinition Height="Auto" />
            <!-- 5  qualidade e audio -->
            <RowDefinition Height="Auto" />
            <!-- 6  nome do arquivo -->
            <RowDefinition Height="Auto" />
            <!-- 7  pasta e Baixar -->
            <RowDefinition Height="Auto" />
            <!-- 8  andamento -->
            <RowDefinition Height="Auto" />
            <!-- 9  concluido -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="YTDown" Style="{StaticResource HeadingText}" />
                <TextBlock Style="{StaticResource SubtleText}"
                           Margin="0,4,0,0"
                           Text="Cole o endereço do vídeo do YouTube e clique em Buscar." />

                <TextBlock Style="{StaticResource SubtleText}"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="#FF98A0AF"
                           Text="{Binding MaintenanceMessage}"
                           Visibility="{Binding MaintenanceMessage, Converter={StaticResource NotEmptyToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="16,0,0,0"
                        VerticalAlignment="Top">
                <Button Height="34"
                        Padding="16,0"
                        Content="Histórico"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnHistoryRequested" />

                <Button Margin="8,0,0,0"
                        Height="34"
                        Padding="16,0"
                        Content="Configurações"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnSettingsRequested" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,24,0,0"
              IsEnabled="{Binding DownloadCommand.IsRunning, Converter={StaticResource InverseBoolean}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#FFD5DBE5"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         Height="42"
                         Padding="12,0"
                         VerticalContentAlignment="Center" />
            </Border>

            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    Height="42"
                    Content="Buscar"
                    Style="{StaticResource FlatButton}"
                    Command="{Binding SearchCommand}" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    Visibility="{Binding SearchCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource SubtleText}" Text="Buscando informações do vídeo..." />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" BorderThickness="0" />
        </StackPanel>

        <Border Grid.Row="8"
                Margin="0,18,0,0"
                Style="{StaticResource Card}"
                Padding="16,14"
                Visibility="{Binding DownloadCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="13"
                               Foreground="#FF1B1F26" />
                    <ProgressBar Value="{Binding Progress.Percentage, Mode=OneWay}"
                                 Maximum="100"
                                 Height="6"
                                 Margin="0,10,0,0"
                                 BorderThickness="0"
                                 Foreground="#FF2C6BED" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="16,0,0,0"
                        Height="34"
                        Padding="16,0"
                        Content="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DownloadCancelCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,18,0,0"
                Padding="14,12"
                Background="#FFFDECEC"
                BorderBrush="#FFF3B9B9"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#FF8C2020" />
        </Border>

        <Border Grid.Row="9"
                Margin="0,18,0,0"
                Padding="16,14"
                Background="#FFEDF9F0"
                BorderBrush="#FFB6E3C4"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding DownloadedFile, Converter={StaticResource NotEmptyToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Download concluído"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FF176034" />
                    <TextBlock Text="{Binding DownloadedFile.FileName}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="#FF3C6B4E"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="16,0,0,0"
                        Height="34"
                        Padding="16,0"
                        Content="Abrir pasta"
                        Style="{StaticResource FlatButton}"
                        Command="{Binding OpenContainingFolderCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Margin="0,20,0,0"
                VerticalAlignment="Top"
                Style="{StaticResource Card}"
                Visibility="{Binding Video, Converter={StaticResource NotEmptyToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 16:9, o suficiente para reconhecer o video sem custar a
                     altura que as linhas de escolha precisam. -->
                <Border Grid.Column="0"
                        Width="160" Height="90"
                        CornerRadius="6"
                        Background="#FFEDF0F5"
                        VerticalAlignment="Top">
                    <Image Source="{Binding Video.ThumbnailUrl}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Video.Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FF1B1F26"
                               TextWrapping="Wrap"
                               MaxHeight="52"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="{Binding Video.ChannelName}"
                               Style="{StaticResource SubtleText}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="{Binding DurationText}"
                               Style="{StaticResource SubtleText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            So aparece depois da busca: escolher qualidade antes de saber quais
            existem seria escolher no escuro, e e onde o botao Baixar vive agora,
            junto das decisoes que ele executa.
        -->
        <Grid Grid.Row="5"
              Margin="0,14,0,0"
              IsEnabled="{Binding DownloadCommand.IsRunning, Converter={StaticResource InverseBoolean}}"
              Visibility="{Binding Video, Converter={StaticResource NotEmptyToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="RotuloDaEscolha" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Qualidade"
                       Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center"
                       Visibility="{Binding AvailableQualities, Converter={StaticResource NotEmptyToVisibility}}" />

            <ComboBox Grid.Column="1"
                      Margin="10,0,0,0"
                      Width="120"
                      Height="32"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding AvailableQualities}"
                      SelectedItem="{Binding SelectedQuality}"
                      DisplayMemberPath="Label"
                      IsEnabled="{Binding AudioOnly, Converter={StaticResource InverseBoolean}}"
                      Visibility="{Binding AvailableQualities, Converter={StaticResource NotEmptyToVisibility}}" />

            <CheckBox Grid.Column="2"
                      Margin="18,0,0,0"
                      VerticalAlignment="Center"
                      Content="Baixar somente o áudio (MP3)"
                      FontSize="13"
                      Foreground="#FF3B4252"
                      IsChecked="{Binding AudioOnly}" />
        </Grid>

        <!--
            O nome vem do titulo do video, ja limpo, e nao do que o disco
            recusaria. Fora do cartao de proposito: o cartao mostra o video, com
            o titulo inteiro, e este campo mostra o arquivo.
        -->
        <Grid Grid.Row="6"
              Margin="0,12,0,0"
              IsEnabled="{Binding DownloadCommand.IsRunning, Converter={StaticResource InverseBoolean}}"
              Visibility="{Binding Video, Converter={StaticResource NotEmptyToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="RotuloDaEscolha" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Nome"
                       Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center" />

            <Border Grid.Column="1"
                    Margin="10,0,0,0"
                    Background="White"
                    BorderBrush="#FFD5DBE5"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBox x:Name="FileNameBox"
                         Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="13"
                         Height="32"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         GotKeyboardFocus="OnFileNameFocused"
                         PreviewMouseLeftButtonDown="OnFileNameClicked"
                         PreviewTextInput="OnFileNameTyping" />
            </Border>

            <TextBlock Grid.Column="2"
                       Margin="8,0,0,0"
                       Text="{Binding ExtensionText}"
                       Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="7"
              Margin="0,12,0,0"
              IsEnabled="{Binding DownloadCommand.IsRunning, Converter={StaticResource InverseBoolean}}"
              Visibility="{Binding Video, Converter={StaticResource NotEmptyToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="RotuloDaEscolha" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Salvar em"
                       Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center" />

            <!--
                A lista traz a pasta padrao e as usadas recentemente, para que
                trocar de pasta entre um download e outro seja um clique, e nao
                uma volta ao seletor do Windows.
            -->
            <ComboBox Grid.Column="1"
                      Margin="10,0,0,0"
                      MinWidth="180"
                      MaxWidth="240"
                      Height="32"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding Destinations}"
                      SelectedItem="{Binding SelectedDestination}"
                      DisplayMemberPath="Label"
                      ToolTip="{Binding SelectedDestination.Path}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="ToolTip" Value="{Binding Path}" />
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Height="32"
                    Padding="14,0"
                    FontSize="13"
                    Content="Escolher..."
                    Style="{StaticResource SecondaryButton}"
                    Click="OnChooseDestinationRequested" />

            <Button Grid.Column="4"
                    Margin="16,0,0,0"
                    Height="38"
                    Padding="26,0"
                    Content="Baixar"
                    Style="{StaticResource FlatButton}"
                    Command="{Binding DownloadCommand}" />
        </Grid>

        <!-- Discreto, mas legivel: o mesmo cinza dos textos de apoio da tela. -->
        <TextBlock Grid.Row="11"
                   Margin="0,18,0,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   FontSize="12"
                   Foreground="#FF6A7180"
                   Text="{Binding Credit}" />
    </Grid>
</Window>
