<Window x:Class="YTDown.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTDown"
        Width="780" Height="620"
        MinWidth="660" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F8FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="HeadingText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF1B1F26" />
        </Style>

        <Style x:Key="SubtleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF6A7180" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2C6BED" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#FFB9C4D6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#FF5A6376" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE3E8EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="YTDown" Style="{StaticResource HeadingText}" />
            <TextBlock Style="{StaticResource SubtleText}"
                       Margin="0,4,0,0"
                       Text="Cole o endereco do video do YouTube. O arquivo e salvo na sua pasta Downloads." />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,24,0,0"
              IsEnabled="{Binding DownloadCommand.IsRunning, Converter={StaticResource InverseBoolean}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#FFD5DBE5"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         Height="42"
                         Padding="12,0"
                         VerticalContentAlignment="Center" />
            </Border>

            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    Height="42"
                    Content="Buscar"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding SearchCommand}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Height="42"
                    Content="Baixar"
                    Style="{StaticResource FlatButton}"
                    Command="{Binding DownloadCommand}" />
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,14,0,0"
              IsEnabled="{Binding DownloadCommand.IsRunning, Converter={StaticResource InverseBoolean}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Qualidade"
                       Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center"
                       Visibility="{Binding AvailableQualities, Converter={StaticResource NotEmptyToVisibility}}" />

            <ComboBox Grid.Column="1"
                      Margin="10,0,0,0"
                      Width="120"
                      Height="30"
                      VerticalContentAlignment="Center"
                      ItemsSource="{Binding AvailableQualities}"
                      SelectedItem="{Binding SelectedQuality}"
                      DisplayMemberPath="Label"
                      IsEnabled="{Binding AudioOnly, Converter={StaticResource InverseBoolean}}"
                      Visibility="{Binding AvailableQualities, Converter={StaticResource NotEmptyToVisibility}}" />

            <CheckBox Grid.Column="2"
                      Margin="18,0,0,0"
                      VerticalAlignment="Center"
                      Content="Baixar somente o audio (MP3)"
                      FontSize="13"
                      Foreground="#FF3B4252"
                      IsChecked="{Binding AudioOnly}" />
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="0,18,0,0"
                    Visibility="{Binding SearchCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Style="{StaticResource SubtleText}" Text="Buscando informacoes do video..." />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" BorderThickness="0" />
        </StackPanel>

        <Border Grid.Row="4"
                Margin="0,18,0,0"
                Style="{StaticResource Card}"
                Padding="16,14"
                Visibility="{Binding DownloadCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="13"
                               Foreground="#FF1B1F26" />
                    <ProgressBar Value="{Binding Progress.Percentage, Mode=OneWay}"
                                 Maximum="100"
                                 Height="6"
                                 Margin="0,10,0,0"
                                 BorderThickness="0"
                                 Foreground="#FF2C6BED" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="16,0,0,0"
                        Height="34"
                        Padding="16,0"
                        Content="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DownloadCancelCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Margin="0,18,0,0"
                Padding="14,12"
                Background="#FFFDECEC"
                BorderBrush="#FFF3B9B9"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="#FF8C2020" />
        </Border>

        <Border Grid.Row="6"
                Margin="0,18,0,0"
                Padding="16,14"
                Background="#FFEDF9F0"
                BorderBrush="#FFB6E3C4"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding DownloadedFile, Converter={StaticResource NotEmptyToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Download concluido"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FF176034" />
                    <TextBlock Text="{Binding DownloadedFile.FileName}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="#FF3C6B4E"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="1"
                        Margin="16,0,0,0"
                        Height="34"
                        Padding="16,0"
                        Content="Abrir pasta"
                        Style="{StaticResource FlatButton}"
                        Command="{Binding OpenContainingFolderCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="7"
                Margin="0,20,0,0"
                VerticalAlignment="Top"
                Style="{StaticResource Card}"
                Visibility="{Binding Video, Converter={StaticResource NotEmptyToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="200" Height="112"
                        CornerRadius="6"
                        Background="#FFEDF0F5"
                        VerticalAlignment="Top">
                    <Image Source="{Binding Video.ThumbnailUrl}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Video.Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FF1B1F26"
                               TextWrapping="Wrap"
                               MaxHeight="52"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Text="{Binding Video.ChannelName}"
                               Style="{StaticResource SubtleText}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="{Binding DurationText}"
                               Style="{StaticResource SubtleText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
