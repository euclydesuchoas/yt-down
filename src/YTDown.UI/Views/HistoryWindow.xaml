<Window x:Class="YTDown.UI.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico"
        Width="640" Height="560"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F8FA"
        FontFamily="Segoe UI">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Histórico" Style="{StaticResource HeadingText}" />
                <TextBlock Style="{StaticResource SubtleText}"
                           Margin="0,4,0,0"
                           Text="O que você já baixou. Limpar a lista não apaga nenhum arquivo." />
            </StackPanel>

            <Button Grid.Column="1"
                    Margin="16,0,0,0"
                    Height="34"
                    Padding="16,0"
                    VerticalAlignment="Top"
                    Content="Limpar"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnClearRequested" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="0,28,0,0"
                   VerticalAlignment="Top"
                   Style="{StaticResource SubtleText}"
                   Text="Nada baixado até agora. O que você baixar aparece aqui."
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="14"
                                               Foreground="#FF1B1F26"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Entry.FilePath}" />

                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource SubtleText}"
                                               FontSize="12"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Margin="14,0,0,0"
                                        Height="30"
                                        Padding="14,0"
                                        FontSize="13"
                                        Content="Abrir pasta"
                                        Style="{StaticResource FlatButton}"
                                        Command="{Binding DataContext.OpenContainingFolderCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
