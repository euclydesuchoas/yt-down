<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>YTDown</AssemblyName>
  </PropertyGroup>

  <!-- Identificacao que o Windows mostra nas propriedades do arquivo e no
       gerenciador de tarefas. Sem isso o aplicativo aparece como "YTDown.UI". -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>YTDown</Product>
    <AssemblyTitle>YTDown</AssemblyTitle>
    <Description>Baixa videos e audios do YouTube.</Description>
    <Authors>Euclydes Uchoas</Authors>
    <Copyright>Euclydes Uchoas</Copyright>
  </PropertyGroup>

  <!--
    Compilar antecipadamente troca tamanho por tempo de abertura. O publico deste
    aplicativo julga qualidade pelo tempo ate a janela aparecer, e o pacote ja e
    grande por causa do FFmpeg: os megabytes a mais pesam pouco no total.
  -->
  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- A UI e o composition root: e o unico projeto que conhece o container concreto. -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YTDown.Application\YTDown.Application.csproj" />
    <ProjectReference Include="..\YTDown.Infrastructure\YTDown.Infrastructure.csproj" />
  </ItemGroup>
	
  <!--
    As ferramentas externas nao sao versionadas (ver scripts/bootstrap-tools.ps1).
    A condicao Exists mantem o build funcionando em um clone limpo: a ausencia vira
    um aviso no build e um erro claro em tempo de execucao, nunca uma falha de MSBuild.
  -->
  <ItemGroup>
    <Content Include="..\..\tools\yt-dlp.exe" Condition="Exists('..\..\tools\yt-dlp.exe')">
      <Link>tools\yt-dlp.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="..\..\tools\ffmpeg.exe" Condition="Exists('..\..\tools\ffmpeg.exe')">
      <Link>tools\ffmpeg.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- Acompanha a instalacao para que o aplicativo saiba qual versao do
         yt-dlp ele traz, e so recopie quando essa versao mudar. -->
    <Content Include="..\..\tools\tools.lock.json">
      <Link>tools\tools.lock.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="WarnAboutMissingExternalTools" BeforeTargets="Build">
    <Warning Condition="!Exists('..\..\tools\yt-dlp.exe') Or !Exists('..\..\tools\ffmpeg.exe')"
             Text="Ferramentas externas ausentes em tools/. Execute: pwsh ./scripts/bootstrap-tools.ps1" />
  </Target>

</Project>
